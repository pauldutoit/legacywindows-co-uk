---
import BaseLayout from '../../layouts/BaseLayout.astro';
import siteConfig from '../../data/site.config.json';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const siteOrigin = `https://${siteConfig.domain}`;
const url = `${siteOrigin}/blog/${post.data.slug}/`;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.publishDate,
  author: { '@type': 'Organization', name: post.data.author },
  publisher: { '@type': 'Organization', name: siteConfig.siteName, url: siteOrigin },
  mainEntityOfPage: url,
  keywords: post.data.heroKeyword,
  articleSection: post.data.category,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteOrigin}/` },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${siteOrigin}/blog/` },
    { '@type': 'ListItem', position: 3, name: post.data.title, item: url },
  ],
};

const otherPosts = (await getCollection('blog'))
  .filter((p) => p.data.slug !== post.data.slug)
  .sort((a, b) => (a.data.publishDate < b.data.publishDate ? 1 : -1))
  .slice(0, 3);
---

<BaseLayout title={`${post.data.title} | ${siteConfig.siteName}`} description={post.data.description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <div class="container blog-post" style="padding-top: 1.5rem;">
    <nav class="breadcrumb" aria-label="breadcrumb">
      <a href="/">Home</a> / <a href="/blog/">Blog</a> / {post.data.category}
    </nav>

    <article>
      <header class="post-header">
        <span class="blog-cat">{post.data.category}</span>
        <h1>{post.data.title}</h1>
        <p class="post-meta">
          <time datetime={post.data.publishDate}>{new Date(post.data.publishDate).toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
          <span aria-hidden="true"> &middot; </span>
          <span>{post.data.readingTime} min read</span>
          <span aria-hidden="true"> &middot; </span>
          <span>By {post.data.author}</span>
        </p>
      </header>

      <div class="post-body">
        <Content />
      </div>

      <aside class="post-cta">
        <h2>Compare quotes for your project</h2>
        <p>Three vetted UK installers, one 60-second brief, no cold calls.</p>
        <a class="btn btn-accent" href="/quote">Get my free quotes &rarr;</a>
      </aside>
    </article>

    {otherPosts.length > 0 && (
      <section class="post-more">
        <h2>Keep reading</h2>
        <ul class="blog-list">
          {otherPosts.map((p) => (
            <li class="blog-card">
              <a href={`/blog/${p.data.slug}/`}>
                <span class="blog-cat">{p.data.category}</span>
                <h3>{p.data.title}</h3>
                <p>{p.data.description}</p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .blog-post { max-width: 780px; }
  .post-header { margin: 1rem 0 2rem; }
  .post-header h1 { font-size: clamp(1.75rem, 3.2vw, 2.4rem); line-height: 1.2; margin: 0.5rem 0 1rem; }
  .post-meta { color: var(--color-muted); font-size: 0.9rem; }
  .blog-cat { display: inline-block; font-size: 0.78rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-primary); }
  .post-body { font-size: 1.05rem; line-height: 1.72; color: var(--color-text); }
  .post-body :global(h2) { font-size: 1.5rem; margin: 2.5rem 0 0.75rem; line-height: 1.3; }
  .post-body :global(h3) { font-size: 1.15rem; margin: 1.5rem 0 0.5rem; }
  .post-body :global(p) { margin: 0 0 1rem; }
  .post-body :global(ul), .post-body :global(ol) { margin: 0 0 1rem 1.2rem; }
  .post-body :global(li) { margin-bottom: 0.4rem; }
  .post-body :global(strong) { color: var(--color-primary); }
  .post-body :global(table) { width: 100%; border-collapse: collapse; margin: 1.5rem 0; font-size: 0.95rem; }
  .post-body :global(th), .post-body :global(td) { padding: 0.6rem 0.8rem; border-bottom: 1px solid var(--color-border); text-align: left; }
  .post-body :global(th) { background: var(--color-surface-alt); font-weight: 700; }
  .post-body :global(blockquote) { border-left: 3px solid var(--color-accent); padding: 0.5rem 1rem; margin: 1.5rem 0; color: var(--color-muted); font-style: italic; }
  .post-body :global(code) { background: var(--color-surface-alt); padding: 0.15rem 0.4rem; border-radius: 3px; font-size: 0.92em; }
  .post-cta { margin: 3rem 0 2rem; padding: 1.5rem 1.75rem; background: linear-gradient(135deg, var(--color-primary), color-mix(in srgb, var(--color-primary) 70%, black)); color: #fff; border-radius: var(--radius-md); text-align: center; }
  .post-cta h2 { color: #fff; margin: 0 0 0.5rem; font-size: 1.35rem; }
  .post-cta p { color: rgba(255,255,255,0.85); margin: 0 0 1rem; }
  .post-more { margin: 2.5rem 0 4rem; }
  .post-more h2 { margin-bottom: 1rem; }
  .blog-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); }
  .blog-card { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-md); overflow: hidden; }
  .blog-card a { display: block; padding: 1rem 1.15rem; color: inherit; text-decoration: none; }
  .blog-card h3 { font-size: 1rem; margin: 0.5rem 0; line-height: 1.35; }
  .blog-card p { font-size: 0.88rem; color: var(--color-muted); margin: 0; line-height: 1.5; }
</style>
