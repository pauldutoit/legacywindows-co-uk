---
import BaseLayout from '../layouts/BaseLayout.astro';
import siteConfig from '../data/site.config.json';
import cities from '../data/cities.json';
import intents from '../data/intents.json';
import cityEnrichment from '../data/cityEnrichment.json';

export async function getStaticPaths() {
  return cities.map((city) => ({
    params: { citySlug: city.slug },
    props: { city },
  }));
}

const { city } = Astro.props as any;
type CityEnrichment = { postcodes?: string[]; houseTypes?: string; notableAreas?: string[]; conservationNote?: string; dominantEra?: string };
const enrichment: CityEnrichment = (cityEnrichment as Record<string, CityEnrichment>)[city.slug] ?? {};

const indexable = city.indexable === true;
const pf = city.pf ?? 1;
const pageUrl = `https://${siteConfig.domain}/${city.slug}/`;
const nearbyCities = (city.nearby ?? []).map((slug: string) => cities.find((c) => c.slug === slug)).filter(Boolean);

const metaTitle = `Double Glazing ${city.name}: Compare Window & Door Quotes`.slice(0, 60);
const metaDescription = `Compare fixed-price quotes for UPVC windows, sash windows, French doors, bay windows and secondary glazing across ${city.name}. FENSA-registered installers, no cold calls.`.slice(0, 155);

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: `${siteConfig.siteName} - ${city.name}`,
  url: pageUrl,
  areaServed: { '@type': 'City', name: city.name },
  provider: { '@type': 'Organization', name: siteConfig.siteName },
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `https://${siteConfig.domain}/` },
    { '@type': 'ListItem', position: 2, name: 'Areas', item: `https://${siteConfig.domain}/areas` },
    { '@type': 'ListItem', position: 3, name: city.name, item: pageUrl },
  ],
};
const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `Double glazing services in ${city.name}`,
  itemListElement: intents.map((i, idx) => ({
    '@type': 'ListItem',
    position: idx + 1,
    name: `${i.label} in ${city.name}`,
    url: `https://${siteConfig.domain}/${i.slug}-${city.slug}/`,
  })),
};
---

<BaseLayout title={metaTitle} description={metaDescription} indexable={indexable}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />

  <div class="container city-page" style="padding-top: 1.5rem;">
    <nav class="breadcrumb" aria-label="breadcrumb">
      <a href="/">Home</a> / <a href="/areas">Areas</a> / {city.name}
    </nav>

    <div class="city-grid">
      <div class="city-main">
        <h1>Double glazing in {city.name}</h1>
        <p class="lede">Compare fixed-price quotes for UPVC windows, sash windows, French doors, bay windows and secondary glazing from FENSA-registered installers covering {city.name} and {city.region}. All quotes are free and there is no obligation.</p>

        <ul class="local-trust-bar">
          <li><strong>FENSA</strong><span>vetted local installers</span></li>
          <li><strong>10yr</strong><span>typical guarantee</span></li>
          <li><strong>&lt; 24h</strong><span>quotes back in {city.name}</span></li>
          <li><strong>Part L</strong><span>compliant certification</span></li>
        </ul>

        <section class="section" style="padding-top: 1.5rem;">
          <div class="section-title">
            <h2>Services and typical prices in {city.name}</h2>
            <p>Prices reflect {city.name}'s regional cost factor. All figures are fitted, VAT-inclusive, sourced from our vetted installer network.</p>
          </div>
          <table class="price-table">
            <thead><tr><th>Service</th><th>Typical fitted price in {city.name}</th><th>&nbsp;</th></tr></thead>
            <tbody>
              {intents.map((i) => {
                const range = i.basePriceRange
                  ? `£${Math.round(i.basePriceRange[0] * pf).toLocaleString()} - £${Math.round(i.basePriceRange[1] * pf).toLocaleString()}`
                  : i.priceFrom;
                return (
                  <tr>
                    <td><a href={`/${i.slug}-${city.slug}/`}>{i.label} in {city.name}</a></td>
                    <td>{range}</td>
                    <td><a class="pill" href={`/${i.slug}-${city.slug}/`}>See details &rarr;</a></td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </section>

        {(enrichment.houseTypes || enrichment.dominantEra || enrichment.conservationNote) && (
          <section class="local-context">
            <h2>Windows and doors in {city.name} - what to know locally</h2>
            {enrichment.houseTypes && <p>{enrichment.houseTypes}</p>}
            {enrichment.dominantEra && <p><strong>Dominant era of housing stock:</strong> {enrichment.dominantEra}</p>}
            {enrichment.conservationNote && (
              <p class="local-context-note"><strong>Heritage note:</strong> {enrichment.conservationNote}</p>
            )}
          </section>
        )}

        {enrichment.notableAreas?.length ? (
          <section class="section" style="padding-top: 0;">
            <div class="section-title"><h2>Neighbourhoods we cover in {city.name}</h2></div>
            <ul class="pill-list">
              {enrichment.notableAreas.map((a) => <li class="pill" style="cursor:default">{a}</li>)}
            </ul>
          </section>
        ) : null}

        {enrichment.postcodes?.length ? (
          <section class="postcodes-box">
            <h2>Postcodes in {city.name}</h2>
            <ul class="postcode-pills">
              {enrichment.postcodes.map((p) => <li>{p}</li>)}
            </ul>
            <p class="postcodes-note">Not seeing your postcode? Request a quote anyway - we likely still cover it.</p>
          </section>
        ) : null}

        <div class="cta-banner">
          <h2>Get 3 quotes for your project in {city.name}</h2>
          <a class="btn btn-accent" href={`/quote?city=${city.slug}`}>Get a free quote &rarr;</a>
        </div>

        {nearbyCities.length > 0 && (
          <section class="section" style="padding-top: 0;">
            <div class="section-title"><h2>Nearby areas</h2></div>
            <ul class="pill-list">
              {nearbyCities.map((c: any) => (
                <li><a class="pill" href={`/${c.slug}/`}>Double glazing in {c.name}</a></li>
              ))}
            </ul>
          </section>
        )}
      </div>

      <aside class="city-sidebar" aria-label="Get a quote">
        <div class="quote-sticky card">
          <h2>Free quote in {city.name}</h2>
          <p class="quote-sticky-sub">Compare 3 vetted installers. 60 seconds, no cold calls.</p>
          <ul class="quote-sticky-trust">
            <li>&#10003; FENSA-registered installers</li>
            <li>&#10003; Fixed-price itemised quotes</li>
            <li>&#10003; 10-year typical guarantee</li>
          </ul>
          <a class="btn btn-accent btn-block" href={`/quote?city=${city.slug}`}>Start my free quote &rarr;</a>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
